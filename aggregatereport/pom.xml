<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonarsource.mha</groupId>
    <artifactId>javashape</artifactId>
    <version>1.0.3-SNAPSHOT</version>
  </parent>
  <groupId>com.sonarsource.reportingmha</groupId>
  <artifactId>aggregatereport</artifactId>
  <version>1.0.3-SNAPSHOT</version>
  <name>AggregateReport</name>
  <properties> <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths></properties>
  <dependencies>
   <dependency>
    <groupId>com.sonarsource.shapecore</groupId>
    <artifactId>shapecore</artifactId>  
    <version>1.0.3-SNAPSHOT</version>
    </dependency>
    <dependency>
    <groupId>com.sonarsource.shapeapp</groupId>
    <artifactId>shapeapp</artifactId>
    <version>1.0.3-SNAPSHOT</version>
    </dependency>
  </dependencies>
   <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
